% Reader label used inside tableau diagrams.
\renewcommand*{\TAss}{मान्यता}

% The base induction-case helper contains two reader-facing English strings.
% Keep its formal arguments and output structure unchanged while localizing the
% atomic-case label and the exercise placeholder for every Hindi chapter.
\RenewDocumentCommand \indcase { s t{!} m m +m }{%
  \DeclareDocumentMacro \indfrm {#3}%
  \DeclareDocumentMacro \indfrmp {#3}%
  \DeclareDocumentMacro \indcomplex {#4}%
  \IfBooleanTF{#1}
     {$#3$ परमाण्विक है: }{$#3 \ident #4$: }
  \IfBooleanTF{#2}
     {अभ्यास।}
     {#5}}

% Propositional-logic register. IGNOU's Hindi logic materials use
% "प्रतिज्ञप्ति" for proposition; the compounds below keep the object-language
% variable distinct from a whole proposition and make the truth-value role of
% a valuation explicit for first-time readers.
\settexttoken{propositional variable}{प्रतिज्ञप्ति चर}{प्रतिज्ञप्ति चरों}[प्रतिज्ञप्ति चर][प्रतिज्ञप्ति चरों]
